# Security
JWT_SECRET_KEY=must_be_set_in_production

# Firebase Auth/Firestore
FIREBASE_CREDENTIALS=/app/firebase_credentials.json

# Google Drive BYOS OAuth config
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gdrive/callback
ENCRYPTION_KEY=your_base64_urlsafe_32_byte_key

# Dev Only
USE_MOCK_AUTH=false
